"]},"Code":{"ZipFile":"def handler(e,c):\n return {'statusCode':503,'headers':{'Content-Type':'text/plain; charset=utf-8'},'body':'cf-warmer is installing, refresh in a minute'}\n"},"Environment":{"Variables":{"TABLE":{"Ref":"Table"},"REGIONS":{"Fn::Join":[",",{"Ref":"Regions"}]},"ALLOWED_HOSTS":{"Ref":"AllowedHosts"},"MAX_OBJECT_MB":{"Ref":"MaxObjectMB"},"MAX_DIR_FILES":{"Ref":"MaxDirFiles"},"WORKER_TIMEOUT":"900","PANEL_ROLE_ARN":{"Fn::GetAtt":["PanelRole","Arn"]}}}}},"PanelUrl":{"Type":"AWS::Lambda::Url","Properties":{"AuthType":"NONE","TargetFunctionArn":{"Fn::GetAtt":["PanelFunction","Arn"]}}},"PanelUrlPermission":{"Type":"AWS::Lambda::Permission","Properties":{"FunctionName":{"Ref":"PanelFunction"},"Action":"lambda:InvokeFunctionUrl","Principal":"*","FunctionUrlAuthType":"NONE"}},"PanelInvokePermission":{"Type":"AWS::Lambda::Permission","Properties":{"FunctionName":{"Ref":"PanelFunction"},"Action":"lambda:InvokeFunction","Principal":"*","InvokedViaFunctionUrl":true}},"ScheduleTick":{"Type":"AWS::Events::Rule","Properties":{"Description":"cf-warmer：每分钟检查并执行到点的预定预热","ScheduleExpression":"rate(1 minute)","State":"ENABLED","Targets":[{"Id":"panel","Arn":{"Fn::GetAtt":["PanelFunction","Arn"]}}]}},"ScheduleTickPermission":{"Type":"AWS::Lambda::Permission","Properties":{"FunctionName":{"Ref":"PanelFunction"},"Action":"lambda:InvokeFunction","Principal":"events.amazonaws.com","SourceArn":{"Fn::GetAtt":["ScheduleTick","Arn"]}}},"InstallerRole":{"Type":"AWS::IAM::Role","Properties":{"AssumeRolePolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"lambda.amazonaws.com"},"Action":"sts:AssumeRole"}]},"Policies":[{"PolicyName":"logs","PolicyDocument":{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],"Resource":{"Fn::Sub":"arn:${AWS::Partition}:logs:*:${AWS::AccountId}:log-group:/aws/lambda/cf-warmer-installer*"}}]}},{"PolicyName":"app","PolicyDocument":{